/*
 * secrets.h.example — Plantilla de credenciales del minitool.
 *
 * Copiala a "secrets.h" (en esta misma carpeta) y poné las tuyas:
 *
 *   copy secrets.h.example secrets.h      (Windows)
 *   cp   secrets.h.example secrets.h      (Linux/Mac)
 *
 * secrets.h está en .gitignore, así que tus claves NO se suben al repo. Este
 * archivo (el .example) sí se versiona, para que quien clone sepa qué completar.
 *
 * wifi_manager.c lo incluye solo si existe (__has_include), así que el proyecto
 * compila igual sin él — pero con credenciales de relleno que no conectan a
 * nada, y en ese caso hay que cargar la red a mano en la tool Red.
 *
 * OJO: esto es solo el RESPALDO. La red que manda es la que esté guardada en
 * NVS desde la tool Red; estas credenciales se usan cuando la NVS está vacía,
 * que es lo que pasa después de un borrado de flash.
 */
#pragma once

#define WIFI_SSID     "MiRedWiFi"
#define WIFI_PASSWORD "mi-clave-wifi"

/* Credenciales del broker MQTT (Mosquitto en la Pi). Mientras estén comentadas,
 * el nodo conecta anónimo (broker sin auth). Para migrar a un broker con
 * password, descomentá y poné el usuario/clave creados con `mosquitto_passwd`. */
// #define MQTT_USER "fleet"
// #define MQTT_PASS "tu-clave-mqtt"
