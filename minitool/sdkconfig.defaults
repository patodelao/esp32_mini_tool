CONFIG_LV_USE_USER_DATA=y
CONFIG_LV_COLOR_16_SWAP=y
CONFIG_LV_COLOR_DEPTH_16=y

# Pool de LVGL a 64KB (default 32KB): el menú rota el bloque central con
# transform_angle, que necesita un layer buffer transitorio (~22KB) además de
# los objetos. Con 32KB no entra y la rotación se descarta.
CONFIG_LV_MEM_SIZE_KILOBYTES=64
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# Tema oscuro por defecto (fondos oscuros, texto claro legible en las tools)
CONFIG_LV_THEME_DEFAULT_DARK=y

# Widget QR para la tool "QR WiFi"
CONFIG_LV_USE_QRCODE=y

# Flash real de la placa: 16MB
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Tabla de particiones custom (3MB app + 1MB storage)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Bluetooth LE (host NimBLE)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
