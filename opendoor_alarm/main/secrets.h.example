/*
 * secrets.h.example — Plantilla de credenciales del nodo.
 *
 * Copiala a "secrets.h" (en esta misma carpeta) y poné las tuyas:
 *
 *   copy secrets.h.example secrets.h      (Windows)
 *   cp   secrets.h.example secrets.h      (Linux/Mac)
 *
 * secrets.h está en .gitignore, así que tus claves NO se suben al repo. Este
 * archivo (el .example) sí se versiona, para que quien clone sepa qué completar.
 *
 * main.c lo incluye solo si existe (__has_include), así que el proyecto compila
 * igual sin él — pero con credenciales de relleno que no conectan a nada.
 */
#pragma once

#define WIFI_SSID     "MiRedWiFi"
#define WIFI_PASSWORD "mi-clave-wifi"

/* Clave para actualizar el firmware por Wi-Fi (ota_web). */
#define OTA_PASSWORD  "cambiame"

/* Auth del broker (Fase 2). ESTE nodo HOSPEDA el broker (Mongoose), así que
 * estas credenciales son las que el broker EXIGE a quien se conecte. Comentadas
 * = broker anónimo (como hasta ahora). Al descomentarlas y reflashear el refri,
 * el broker rechaza a todo el que no mande exactamente este usuario/clave.
 *
 * ORDEN SEGURO (todo por OTA, sin lockout):
 *   1) Poné el MISMO MQTT_USER/MQTT_PASS en los secrets de minitool, esp32cam y
 *      esp8266 (pieza), y flashealos. El broker sigue anónimo => conectan igual.
 *   2) Verificá en la tool Nodos que los tres queden online.
 *   3) Recién ahí descomentá acá y reflasheá el refri: pasa a exigir la clave.
 *      El refri publica su telemetría in-process, así que NO se puede autobloquear. */
