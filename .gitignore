# ESP-IDF build artifacts
build/
managed_components/
dependencies.lock

# sdkconfig generado (se regenera desde sdkconfig.defaults)
sdkconfig
sdkconfig.old

# Editor (rutas locales de la máquina)
**/.vscode/settings.json
*.swp

# Credenciales locales (WiFi, OTA). Ver los .example de cada proyecto.
**/secrets.h
**/secrets.ini

# Credenciales de servicios de la Pi (local_key de Tuya, token ntfy, etc.).
# Se versionan solo los .example.
**/*.env
!**/*.env.example

# Cache de Python (se regenera solo).
__pycache__/
*.pyc
