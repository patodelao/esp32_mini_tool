# push.env.example — Config del servicio de push de alertas al celu.
#
# Copialo a /home/pi/homelab/push.env y completá tus valores. El .service lo lee
# como EnvironmentFile. NO subas push.env a git (tiene tu clave del broker).
#
#   cp push.env.example /home/pi/homelab/push.env
#   nano /home/pi/homelab/push.env
#
# Instalación completa (en la Pi):
#   pip3 install paho-mqtt requests
#   cp homelab_push.py /home/pi/homelab/
#   sudo cp homelab-push.service /etc/systemd/system/
#   sudo systemctl enable --now homelab-push
#   journalctl -u homelab-push -f          # ver que conecte y empuje
#
# En el celu: instalá la app "ntfy" y suscribite al MISMO topic de NTFY_URL.

# Credenciales del broker (las mismas de la flota, auth activa).
MQTT_USER=fleet
MQTT_PASS=PONE_TU_CLAVE_MQTT

# Tu URL de ntfy. El topic es tu "clave": elegí uno largo e impredecible, porque
# cualquiera que lo conozca puede ver (y publicar) tus alertas.
NTFY_URL=https://ntfy.sh/homelab-CAMBIA-ESTO-por-algo-largo-42

# Nivel mínimo a empujar: alarma | aviso | ok. "aviso" deja pasar aviso+alarma.
MIN_LEVEL=aviso

# Broker (opcional; por defecto el refri).
# BROKER=192.168.1.108
# PORT=1883
