; Plantilla de credenciales del nodo. Copiala a "secrets.ini" y poné las tuyas:
;
;   copy secrets.ini.example secrets.ini      (Windows)
;   cp   secrets.ini.example secrets.ini      (Linux/Mac)
;
; secrets.ini está en .gitignore, así que tus claves NO se suben al repo.
; Este archivo (el .example) sí se versiona, para que quien clone sepa qué
; tiene que completar.
;
; PlatformIO las inyecta como -D al compilar (ver build_flags en platformio.ini),
; así que main.cpp las usa igual que antes.

[secrets]
; Red WiFi del nodo (2.4 GHz: el ESP8266 no hace 5 GHz)
wifi_ssid = MiRedWiFi
wifi_password = mi-clave-wifi

; Clave para actualizar el nodo por WiFi (OTA). Elegí una propia y no la
; reutilices de otro lado.
ota_password = cambiame

; Credenciales del broker MQTT (Mosquitto en la Pi). Solo se usan si en
; platformio.ini descomentás las líneas -DMQTT_USER/-DMQTT_PASS. Mientras tanto
; el nodo conecta anónimo. Deben coincidir con el usuario de `mosquitto_passwd`.
; mqtt_user = fleet
; mqtt_pass = tu-clave-mqtt
